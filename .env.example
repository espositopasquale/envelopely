# SECURITY WARNING
# A completed environment file contains credentials in plain text. Use it only
# on a trusted, access-controlled machine. Never commit, upload, share, log, or
# distribute it. Prefer a revocable application password or SMTP token.

# SMTP settings are required only when using --send.
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=you@example.com
MAIL_SMTP_PASS=replace-me
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Your Name
MAIL_REPLY_TO=you@example.com

# Optional sender details and campaign defaults.
MAIL_SENDER_TITLE=Your role
MAIL_SENDER_WEBSITE=https://example.com
MAIL_CONTACTS=examples/contacts.csv
MAIL_TEMPLATE=templates/default.txt
MAIL_ATTACHMENTS=path/to/attachment.pdf
MAIL_LANGUAGE=en
MAIL_AUDIENCE=nontechnical
